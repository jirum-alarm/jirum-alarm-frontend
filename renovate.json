{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "schedule": ["* * * * 0,6"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "automergeType": "pr",
  "labels": ["dependencies"],
  "ignorePaths": ["**/.next/**"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "automerge": false,
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "apps/web npm patch/minor — CI 통과 시 자동 머지. main 푸시는 웹 스테이징까지만(운영은 v* 태그).",
      "matchManagers": ["npm"],
      "matchFileNames": ["apps/web/package.json"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "web non-major",
      "automerge": true
    },
    {
      "description": "devDependencies patch/minor — CI 통과 시 자동 머지 (apps/mobile 은 아래 규칙이 덮어써 제외)",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "devDependencies non-major",
      "automerge": true
    },
    {
      "description": "apps/mobile 은 main 푸시가 곧 자동 OTA — 자동 머지 금지, 주 1회 묶음",
      "matchFileNames": ["apps/mobile/**"],
      "groupName": "mobile JS",
      "schedule": ["* 0-8 * * 6"],
      "automerge": false
    },
    {
      "description": "Expo·React Native 네이티브 계열 — 자동 머지 금지, 별도 그룹, 주 1회. 네이티브 변경은 같은 커밋에서 runtimeVersion 올림 + native:write 필요(AGENTS.md §Mobile App).",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "@expo/**",
        "react-native",
        "react-native-*",
        "@react-native*/**",
        "@sentry/react-native",
        "nativewind"
      ],
      "groupName": "mobile native (expo / react-native)",
      "schedule": ["* 0-8 * * 6"],
      "automerge": false,
      "labels": ["dependencies", "mobile-native"]
    },
    {
      "description": "앱의 react 버전은 react-native 렌더러와 맞물림 — 네이티브 그룹으로",
      "matchFileNames": ["apps/mobile/package.json"],
      "matchPackageNames": ["react", "react-test-renderer"],
      "groupName": "mobile native (expo / react-native)",
      "schedule": ["* 0-8 * * 6"],
      "automerge": false,
      "labels": ["dependencies", "mobile-native"]
    },
    {
      "description": "ios/android/Gemfile 은 expo prebuild·RN 템플릿이 관리 — Renovate 대상 아님",
      "matchFileNames": ["apps/mobile/ios/**", "apps/mobile/android/**", "apps/mobile/Gemfile"],
      "enabled": false
    }
  ]
}
