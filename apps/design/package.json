{
  "name": "design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "지름알림 디자인 시스템 놀이터 — 토큰·조립 규칙·부품을 직접 조작하고, 스토리마다 동작·접근성 검사를 자동으로 돌린다",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "check-types": "tsc --noEmit",
    "prettier-fix": "prettier --write \"./**/*.{js,ts,tsx}\" --ignore-path .gitignore"
  },
  "dependencies": {
    "@jirum/design-system": "workspace:*",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@jirum/eslint-config-jirum": "workspace:*",
    "@jirum/prettier": "workspace:*",
    "@jirum/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "^10.6.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
