{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "concurrently --kill-others  \"NEXT_PUBLIC_API_MOCKING=enable next dev\" \"npx tsx watch ./src/shared/mocks/http.ts\"",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "generate:svg-component": "npx @svgr/cli --ignore-existing --jsx-runtime=automatic --out-dir src/components/common/icons --typescript -- src/assets/icons",
    "code-gen": "pnpm graphql-codegen --config codegen.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prettier-fix": "prettier --write \"./**/*.{js,ts,tsx}\" --ignore-path .gitignore --ignore-path .prettierignore ",
    "check-types": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "ANALYZE=true next build --webpack",
    "knip": "knip"
  },
  "dependencies": {
    "@apollo/client": "^4.3.3",
    "@jirum/design-system": "workspace:*",
    "@microsoft/clarity": "^1.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@sentry/nextjs": "^10.76.2",
    "@sentry/opentelemetry": "10.76.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-next-experimental": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "firebase": "^13.0.0",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.3.0",
    "jotai": "^3.0.1",
    "motion": "^12.43.0",
    "next": "16.4.0",
    "next-runtime-env": "^3.3.0",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-intersection-observer": "^11.0.1",
    "react-scroll": "^1.9.3",
    "sharp": "^0.35.5",
    "rxjs": "^7.8.2",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/near-operation-file-preset": "^5.2.2",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@jirum/eslint-config-jirum": "workspace:*",
    "@jirum/prettier": "workspace:*",
    "@jirum/tsconfig": "workspace:*",
    "@msw/serve": "^0.11.0",
    "@next/bundle-analyzer": "^16.4.0",
    "@parcel/watcher": "^2.6.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-scroll": "^1.8.10",
    "@types/react-swipeable-views": "^0.13.6",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "^10.6.1",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.1",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
