{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "pnpm run app-run:android",
    "ios": "pnpm run app-run:ios",
    "app-run:android": "expo run:android",
    "app-run:ios": "expo run:ios",
    "app-deploy:check": "node scripts/deploy-init.mjs",
    "app-deploy": "node scripts/deploy-using-eas-local.mjs",
    "clean-ios": "cd ios && rm -rf build && pod cache clean --all && pod deintegrate && rm Podfile.lock && pod install",
    "clean-android": "./android/gradlew -p android --stop && rm -rf android/app/.cxx && ./android/gradlew -p android clean && rm -rf android/.gradle android/build android/app/build",
    "generate": "graphql-codegen",
    "generate:schema": "graphql-codegen --config codegen.schema.ts",
    "check-types": "tsc --noEmit",
    "ts:check": "pnpm run check-types",
    "lint": "eslint App.tsx index.js src __tests__ babel.config.js metro.config.js react-native.config.js jest.config.js",
    "prettier-fix": "prettier --config .prettierrc.js --write \"./**/*.{js,jsx,ts,tsx,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "verify:contracts": "node scripts/verify-public-contracts.mjs",
    "native:check": "node scripts/native-fingerprint.mjs --check",
    "native:write": "node scripts/native-fingerprint.mjs --write",
    "ota:publish": "node scripts/ota-publish.mjs",
    "ota:rollback": "eas update:rollback",
    "verify:migration": "pnpm generate && pnpm ts:check && pnpm lint && pnpm exec jest --runInBand && npx expo-doctor",
    "start": "expo start",
    "test": "jest",
    "eas-build-pre-install": "node scripts/eas-restore-build-files.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@jirum/design-system": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-cookies/cookies": "6.2.1",
    "@react-native-firebase/analytics": "21.14.0",
    "@react-native-firebase/app": "21.14.0",
    "@react-native-firebase/messaging": "21.14.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-seoul/kakao-login": "5.4.2",
    "@react-native-seoul/naver-login": "4.2.4",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@sentry/react-native": "^7.11.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "^57.0.3",
    "expo-image": "~57.0.5",
    "expo-notifications": "^57.0.22",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-bootsplash": "6.3.12",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.5.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@clack/prompts": "1.8.1",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@graphql-codegen/typed-document-node": "^7.1.1",
    "@parcel/watcher": "^2.6.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eas-cli": "^22.0.0",
    "eslint": "^8.19.0",
    "expo-doctor": "1.20.4",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-cookies/cookies"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
