require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Expo SDK 57 은 iOS 16.4 부터다(RN 0.86 의 min_ios_version_supported 는 아직 15.1 이라 Expo 모듈 podspec 과 어긋난다).
platform :ios, '16.4'

# RN 0.86 은 기본으로 미리 빌드된 RN 코어(React-Core-prebuilt)를 쓰는데, 이 레포는 Firebase 때문에
# use_frameworks! :static 이라 그 조합에서 RNFBApp 이 "non-modular header inside framework module" 로
# 컴파일되지 않는다(2026-10-09 실측). SDK 54 때처럼 RN 을 소스로 빌드한다.
ENV['RCT_USE_RN_DEP'] ||= '0'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '0'
prepare_react_native_project!

# RNFirebase 26 은 기본으로 Firebase iOS SDK 를 SPM 으로 받는데, SPM 산출물은 자동 라이브러리라
# use_frameworks!(static) 에선 RNFB pod 마다 사본이 들어가 링크 때 심볼이 겹친다(pod install 이 거부).
# 21 때처럼 CocoaPods 로 받는다 — 타깃 블록보다 먼저 정해야 한다.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'jirumAlarmMobile' do
  use_expo_modules!
  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true
  # 광고식별자(IDFA) 없는 Analytics — ATT 프롬프트 없이 GA4 이벤트만 보낸다.
  $RNFirebaseAnalyticsWithoutAdIdSupport = true

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26 beta: fmt 라이브러리의 consteval 호환성 이슈 워크어라운드
    # FMT_CONSTEVAL을 consteval에서 constexpr로 변경
    fmt_base_header = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_header)
      content = File.read(fmt_base_header)
      patched = content.gsub(
        '#  define FMT_CONSTEVAL consteval',
        '#  define FMT_CONSTEVAL constexpr'
      )
      if content != patched
        File.write(fmt_base_header, patched)
        Pod::UI.puts "Patched fmt FMT_CONSTEVAL for Xcode 26 compatibility".yellow
      end
    end
  end
end
