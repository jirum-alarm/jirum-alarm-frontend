# dependencies
**/node_modules
/.pnp
.pnp.js

# misc
.DS_Store
*.pem

# local env files
.env*.local

# turbo
.turbo

# mobile native local/generated artifacts
/apps/mobile/.expo/
/apps/mobile/.expo-shared/
/apps/mobile/credentials.json
/apps/mobile/credentials/
/apps/mobile/*.p8
/apps/mobile/*.p12
/apps/mobile/*.mobileprovision
/apps/mobile/*service-account*.json
/apps/mobile/*service_account*.json
/apps/mobile/play-store*.json
/apps/mobile/coverage/
/apps/mobile/build/
/apps/mobile/dist/
/apps/mobile/web-build/
/apps/mobile/.bundle/
/apps/mobile/vendor/bundle/
/apps/mobile/android/.gradle/
/apps/mobile/android/.kotlin/
/apps/mobile/android/app/.cxx/
/apps/mobile/android/app/build
/apps/mobile/android/build
/apps/mobile/android/local.properties
/apps/mobile/android/keystore.properties
/apps/mobile/android/app/google-services.json
/apps/mobile/android/app/debug.keystore
/apps/mobile/android/**/*.jks
/apps/mobile/android/**/*.keystore
/apps/mobile/ios/Pods
/apps/mobile/ios/build
/apps/mobile/ios/.xcode.env.local
/apps/mobile/ios/GoogleService-Info.plist
/apps/mobile/ios/**/xcuserdata/
/apps/mobile/ios/**/*.xcuserstate
# expo-updates config plugin 이 생성한다(pnpm install/prebuild 시). 커밋하면 안 됨.
/apps/mobile/ios/**/Supporting/Expo.plist

.idea
# Ignore Cursor / local agent files
.cursor/
.claude/
.agents/
.gstack/

# 로컬 git worktree 디렉토리. 커밋되면 .gitmodules 없는 gitlink가 되어
# CI의 Post Checkout 단계에서 git exit 128을 낸다.
.worktrees/
